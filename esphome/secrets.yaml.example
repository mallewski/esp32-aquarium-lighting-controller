# Kopiere diese Datei zu secrets.yaml und trage deine echten Werte ein.
# secrets.yaml selbst gehört NICHT ins Repo (siehe .gitignore).

wifi_ssid: "DeinWLANName"
wifi_password: "DeinWLANPasswort"

# 32 Byte Base64 API-Verschlüsselungskey, z.B. via
# `esphome secrets` oder `openssl rand -base64 32` erzeugen
aquarium_steuerung__api_encryption_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="

aquarium_steuerung__ota_password: "DeinOtaPasswort"

# Passwort für den Fallback-Hotspot, falls WLAN ausfällt
aquarium_steuerung__ap_password: "DeinFallbackHotspotPasswort"

# Optional, falls web_server.auth aktiviert wird (empfohlen)
aquarium_steuerung__web_user: "admin"
aquarium_steuerung__web_password: "DeinWebInterfacePasswort"
