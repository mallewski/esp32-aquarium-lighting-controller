# Copy this file to secrets.yaml and fill in your real values.
# secrets.yaml itself must NOT be committed (see .gitignore).

wifi_ssid: "YourWifiName"
wifi_password: "YourWifiPassword"

# 32-byte base64 API encryption key, e.g. generate via
# `esphome secrets` or `openssl rand -base64 32`
aquarium_steuerung__api_encryption_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="

aquarium_steuerung__ota_password: "YourOtaPassword"

# Password for the fallback hotspot in case WiFi goes down
aquarium_steuerung__ap_password: "YourFallbackHotspotPassword"

# Optional, if web_server.auth is enabled (recommended)
aquarium_steuerung__web_user: "admin"
aquarium_steuerung__web_password: "YourWebInterfacePassword"
